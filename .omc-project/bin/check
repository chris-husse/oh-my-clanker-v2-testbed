#!/usr/bin/env bash
# The fast gate: every source file parses (`node --check`), then the unit tests. Extra arguments go to `node --test`
# before the test files (`--test-name-pattern <regex>`). Pass or fail is the exit code.
set -euo pipefail
cd "$(dirname "$0")/../.."

status=0
while IFS= read -r file; do
  node --check "$file" || status=1
done < <(find src -name '*.js' | sort; printf '%s\n' bin/tally scripts/*.mjs mcp/*.mjs)
[ "$status" = 0 ] || exit "$status"

node --disable-warning=ExperimentalWarning --test "$@" 'test/unit/*.test.js'
