@@ -0,0 +1,24 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { formatCents, parseCents } from '../../src/amount.js';
+
+// Amounts of every size an account sees, from a fixed seed: the same samples on every run.
+function* samples(count, seed = 20260101) {
+  let state = seed;
+  const next = () => (state = (state * 1103515245 + 12345) % 2 ** 31) / 2 ** 31;
+  for (let i = 0; i < count; i += 1) {
+    const digits = 1 + Math.floor(next() * 13);
+    const cents = Math.floor(next() * 10 ** digits);
+    yield cents !== 0 && next() < 0.3 ? -cents : cents;
+  }
+}
+
+const enUS = (cents) => (cents / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
+
+test('amounts format as en-US and parse back', () => {
+  for (const cents of samples(500)) {
+    const text = enUS(cents);
+    assert.equal(formatCents(cents), text, `formatCents(${cents})`);
+    assert.equal(parseCents(text), cents, `parseCents('${text}')`);
+  }
+});
