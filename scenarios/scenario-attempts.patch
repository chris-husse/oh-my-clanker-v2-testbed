@@ -0,0 +1,16 @@
+// Amounts as people write them: integer cents to en-US text ("-1,234.05") and back.
+
+const GROUPS = /\B(?=(\d{3})+(?!\d))/;
+
+export function formatCents(cents) {
+  const whole = (cents / 100) | 0;
+  const part = Math.abs(cents % 100);
+  const sign = whole < 0 ? '-' : '';
+  return `${sign}${String(Math.abs(whole)).replace(GROUPS, ',')}.${String(part).padEnd(2, '0')}`;
+}
+
+export function parseCents(text) {
+  const [whole, frac = '0'] = text.replace(',', '').split('.');
+  const sign = Math.sign(Number(whole) || 1);
+  return Number(whole) * 100 + sign * Number(frac.padEnd(2, '0'));
+}
diff --git a/test/unit/amount.test.js b/test/unit/amount.test.js
