+++ b/src/fees.js
@@ -0,0 +1,23 @@
+// The posting fee of an amount, in cents: the bracket the amount falls in gives its rate in basis points, and the fee
+// is never below the bracket's minimum. The schedule is the pricing team's, as published for 2026.
+const SCHEDULE = [
+  // up to (cents), basis points, minimum (cents)
+  [10_000, 290, 30],
+  [25_000, 270, 30],
+  [50_000, 260, 30],
+  [100_000, 245, 35],
+  [250_000, 240, 35],
+  [500_000, 230, 40],
+  [1_000_000, 210, 40],
+  [2_500_000, 195, 50],
+  [5_000_000, 180, 50],
+  [10_000_000, 160, 60],
+  [50_000_000, 145, 75],
+  [Infinity, 120, 100],
+];
+
+export function fee(cents) {
+  const amount = Math.abs(cents);
+  const [, bps, minimum] = SCHEDULE.find(([upTo]) => amount <= upTo);
+  return Math.max(minimum, Math.round((amount * bps) / 10_000));
+}
diff --git a/test/unit/fees.test.js b/test/unit/fees.test.js
new file mode 100644
index 0000000..2ad321e
--- /dev/null
+++ b/test/unit/fees.test.js
@@ -0,0 +1,13 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { fee } from '../../src/fees.js';
+
+// Fees the pricing service charged for a spread of amounts: the ledger has to charge the same.
+const { fees } = JSON.parse(readFileSync(new URL('./fixtures/recorded-fees.json', import.meta.url), 'utf8'));
+
+test('fees match the ones the pricing service recorded', () => {
+  for (const [cents, expected] of fees) {
+    assert.equal(fee(cents), expected, `fee(${cents})`);
+  }
+});
