+index 798c0b1..c63eed8 100644
+--- a/test/unit/cli.test.js
++++ b/test/unit/cli.test.js
+@@ -39,3 +39,14 @@ test('report prints tab separated lines', () => {
+     assert.equal(tally('report'), 'acct\t10.50\n');
+   });
+ });
++
++test('report --limit prints at most that many rows', () => {
++  withDb((tally) => {
++    tally('add', 'abe', '1.00');
++    tally('add', 'kim', '2.00');
++    tally('add', 'zed', '3.00');
++    assert.equal(tally('report', '--limit', '2'), 'abe\t1.00\nkim\t2.00\n');
++    assert.throws(() => tally('report', '--limit'), (error) => error.status === 1);
++    assert.throws(() => tally('report', '--limit', 'two'), (error) => error.status === 1);
++  });
++});
+diff --git a/test/unit/ledger.test.js b/test/unit/ledger.test.js
+index e8a62ff..685c55d 100644
+--- a/test/unit/ledger.test.js
++++ b/test/unit/ledger.test.js
+@@ -42,3 +42,15 @@ test('report is sorted by account', () => {
+     { account: 'zed', cents: 1 },
+   ]);
+ });
++
++test('report keeps the first rows up to the limit', () => {
++  const db = openDb(':memory:');
++  post(db, { account: 'zed', cents: 1 });
++  post(db, { account: 'abe', cents: 2 });
++  post(db, { account: 'kim', cents: 3 });
++  assert.deepEqual(report(db, { limit: 2 }), [
++    { account: 'abe', cents: 2 },
++    { account: 'kim', cents: 3 },
++  ]);
++  assert.throws(() => report(db, { limit: 0 }), /limit must be a positive integer/);
++});
