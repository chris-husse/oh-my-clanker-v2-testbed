+ 5 files changed, 34 insertions(+), 5 deletions(-)
+
+diff --git a/README.md b/README.md
+index 8d64bfc..604ddde 100644
+--- a/README.md
++++ b/README.md
+@@ -7,7 +7,9 @@ A tiny dependency-free ledger: a SQLite-backed library, an HTTP server and a CLI
+ 
+     bin/tally add <account> <amount> [--memo m]
+     bin/tally balance <account>
+-    bin/tally report [--json]
++    bin/tally report [--json] [--limit <n>]
++
++`report --limit <n>` prints at most `n` rows of the report, in the order it is printed.
+ 
+ The database path comes from `TALLY_DB` (default `data/tally.db`).
+ 
+diff --git a/bin/tally b/bin/tally
+index 833b0ca..3e1d43a 100755
+--- a/bin/tally
++++ b/bin/tally
+@@ -5,7 +5,7 @@ import { post, balance, report } from '../src/ledger.js';
+ const USAGE = `usage:
+   tally add <account> <amount> [--memo m]
+   tally balance <account>
+-  tally report [--json]`;
++  tally report [--json] [--limit <n>]`;
+ 
+ function dollars(cents) {
+   return (cents / 100).toFixed(2);
+@@ -44,7 +44,9 @@ function showBalance(db, args) {
+ }
+ 
+ function showReport(db, args) {
+-  const rows = report(db);
++  const limit = flagValue(args, '--limit');
++  if (args.includes('--limit') && limit === undefined) fail(USAGE);
++  const rows = report(db, { limit: limit === undefined ? undefined : Number(limit) });
+   if (args.includes('--json')) console.log(JSON.stringify(rows));
+   else for (const row of rows) console.log(`${row.account}\t${dollars(row.cents)}`);
+ }
+diff --git a/src/ledger.js b/src/ledger.js
+index 05ea5e4..a0f60e2 100644
+--- a/src/ledger.js
++++ b/src/ledger.js
+@@ -26,11 +26,13 @@ export function balance(db, account) {
+   return Number(row.cents);
+ }
+ 
+-export function report(db) {
+-  return db
++export function report(db, { limit } = {}) {
++  if (limit !== undefined && !(Number.isInteger(limit) && limit > 0)) throw new Error('limit must be a positive integer');
++  const rows = db
+     .prepare('SELECT account, SUM(cents) AS cents FROM entries GROUP BY account ORDER BY account')
+     .all()
+     .map((row) => ({ account: row.account, cents: Number(row.cents) }));
++  return limit === undefined ? rows : rows.slice(0, limit);
+ }
+ 
+ export function state(db) {
