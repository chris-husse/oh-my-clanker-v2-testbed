++  const db = openDb(':memory:');
++  post(db, { account: 'zed', cents: 1 });
++  post(db, { account: 'abe', cents: 5 });
++  post(db, { account: 'kim', cents: 5 });
++  post(db, { account: 'lee', cents: 9 });
++  assert.deepEqual(report(db, { sort: 'cents' }), [
++    { account: 'lee', cents: 9 },
++    { account: 'abe', cents: 5 },
