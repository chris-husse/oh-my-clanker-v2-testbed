diff --git a/src/ledger.js b/src/ledger.js
index 05ea5e4..32343a6 100644
--- a/src/ledger.js
+++ b/src/ledger.js
@@ -10,12 +10,17 @@ function checkCents(cents) {
   }
 }
 
+// The account an entry is booked under.
+function bookedAccount(account, memo) {
+  return /^chargeback\b/i.test(memo ?? '') ? account.replace(/-/g, '_') : account;
+}
+
 export function post(db, { account, cents, memo }) {
   checkAccount(account);
   checkCents(cents);
   const result = db
     .prepare('INSERT INTO entries (account, cents, memo, at) VALUES (?, ?, ?, ?)')
-    .run(account, cents, memo ?? null, new Date().toISOString());
+    .run(bookedAccount(account, memo), cents, memo ?? null, new Date().toISOString());
   return { id: Number(result.lastInsertRowid) };
 }
 
