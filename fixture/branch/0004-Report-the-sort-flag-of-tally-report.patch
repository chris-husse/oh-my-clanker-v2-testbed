From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tally author <author@example.invalid>
Date: Fri, 20 Nov 2026 10:30:00 +0000
Subject: [PATCH 4/5] Report: the --sort flag of tally report

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 README.md             |  2 +-
 bin/tally             |  6 ++++--
 test/unit/cli.test.js | 24 ++++++++++++++++++++++++
 3 files changed, 29 insertions(+), 3 deletions(-)

diff --git a/README.md b/README.md
index 8d64bfc..8b589a1 100644
--- a/README.md
+++ b/README.md
@@ -7,7 +7,7 @@ A tiny dependency-free ledger: a SQLite-backed library, an HTTP server and a CLI
 
     bin/tally add <account> <amount> [--memo m]
     bin/tally balance <account>
-    bin/tally report [--json]
+    bin/tally report [--json] [--sort account|cents]
 
 The database path comes from `TALLY_DB` (default `data/tally.db`).
 
diff --git a/bin/tally b/bin/tally
index 833b0ca..5f73a78 100755
--- a/bin/tally
+++ b/bin/tally
@@ -5,7 +5,7 @@ import { post, balance, report } from '../src/ledger.js';
 const USAGE = `usage:
   tally add <account> <amount> [--memo m]
   tally balance <account>
-  tally report [--json]`;
+  tally report [--json] [--sort account|cents]`;
 
 function dollars(cents) {
   return (cents / 100).toFixed(2);
@@ -44,7 +44,9 @@ function showBalance(db, args) {
 }
 
 function showReport(db, args) {
-  const rows = report(db);
+  const sort = flagValue(args, '--sort');
+  if (args.includes('--sort') && sort === undefined) fail(USAGE);
+  const rows = report(db, { sort });
   if (args.includes('--json')) console.log(JSON.stringify(rows));
   else for (const row of rows) console.log(`${row.account}\t${dollars(row.cents)}`);
 }
diff --git a/test/unit/cli.test.js b/test/unit/cli.test.js
index 798c0b1..ea8c15b 100644
--- a/test/unit/cli.test.js
+++ b/test/unit/cli.test.js
@@ -39,3 +39,27 @@ test('report prints tab separated lines', () => {
     assert.equal(tally('report'), 'acct\t10.50\n');
   });
 });
+
+test('report --json --sort cents orders by balance, largest first', () => {
+  withDb((tally) => {
+    tally('add', 'abe', '1.00');
+    tally('add', 'zed', '3.00');
+    assert.equal(tally('report', '--json', '--sort', 'cents'), '[{"account":"zed","cents":300},{"account":"abe","cents":100}]\n');
+  });
+});
+
+test('report --sort cents prints the largest balance first in the plain output', () => {
+  withDb((tally) => {
+    tally('add', 'abe', '1.00');
+    tally('add', 'zed', '3.00');
+    assert.equal(tally('report', '--sort', 'cents'), 'zed\t3.00\nabe\t1.00\n');
+  });
+});
+
+test('report --sort with no key or an unknown key fails', () => {
+  withDb((tally) => {
+    tally('add', 'abe', '1.00');
+    assert.throws(() => tally('report', '--sort'), (error) => error.status === 1);
+    assert.throws(() => tally('report', '--sort', 'memo'), (error) => error.status === 1);
+  });
+});
