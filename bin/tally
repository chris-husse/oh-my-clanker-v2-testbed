#!/usr/bin/env -S node --disable-warning=ExperimentalWarning
import { openDb } from '../src/db.js';
import { post, balance, report } from '../src/ledger.js';

const USAGE = `usage:
  tally add <account> <amount> [--memo m]
  tally balance <account>
  tally report [--json]`;

function dollars(cents) {
  return (cents / 100).toFixed(2);
}

function fail(message) {
  console.error(message);
  process.exit(1);
}

function flagValue(args, name) {
  const at = args.indexOf(name);
  return at === -1 ? undefined : args[at + 1];
}

function positionals(args) {
  const out = [];
  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--memo') i++;
    else if (!args[i].startsWith('--')) out.push(args[i]);
  }
  return out;
}

function add(db, args) {
  const [account, amount] = positionals(args);
  if (!account || amount === undefined) fail(USAGE);
  const cents = Math.round(parseFloat(amount) * 100);
  post(db, { account, cents, memo: flagValue(args, '--memo') });
}

function showBalance(db, args) {
  const [account] = positionals(args);
  if (!account) fail(USAGE);
  console.log(dollars(balance(db, account)));
}

function showReport(db, args) {
  const rows = report(db);
  if (args.includes('--json')) console.log(JSON.stringify(rows));
  else for (const row of rows) console.log(`${row.account}\t${dollars(row.cents)}`);
}

const COMMANDS = { add, balance: showBalance, report: showReport };

const [command, ...args] = process.argv.slice(2);
if (!Object.hasOwn(COMMANDS, command)) fail(USAGE);

const db = openDb(process.env.TALLY_DB ?? 'data/tally.db');
try {
  COMMANDS[command](db, args);
} catch (error) {
  fail(error.message);
}
